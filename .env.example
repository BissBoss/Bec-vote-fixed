# Server deployment only. Local development can keep using node server.mjs.
PUBLIC_ORIGIN=https://aclipseawardbec.io.vn
# Use 127.0.0.1 behind a same-machine HTTPS reverse proxy.
# Container hosting may require HOST=0.0.0.0 instead.
HOST=127.0.0.1
PORT=3000
# Replace with the persistent data directory supplied by your hosting provider.
# DATA_DIR=/persistent/bec-vote
