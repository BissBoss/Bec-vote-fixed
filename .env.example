# Public HTTPS address used to validate browser requests.
PUBLIC_ORIGIN=https://eclipseawardbec.io.vn
# Server-only Supabase credentials. Never expose the secret in browser code.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Private admin password: set a unique value of at least 12 characters.
# Leave empty to disable admin sign-in. Never commit the real password.
ADMIN_PASSWORD=
# Use 127.0.0.1 behind a same-machine HTTPS reverse proxy.
# Container hosting may require HOST=0.0.0.0 instead.
HOST=127.0.0.1
PORT=3000
